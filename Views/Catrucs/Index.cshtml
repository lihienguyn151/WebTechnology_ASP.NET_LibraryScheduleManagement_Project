@model IEnumerable<QuanLyLichTruc.Models.Catruc>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SoThuTuCa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiemDanh)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Canbo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ngaytruc)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SoThuTuCa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiemDanh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Canbo.ChucVu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ngaytruc.NgaytrucID)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CatrucID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CatrucID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CatrucID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
