@model IEnumerable<QuanLyLichTruc.Models.Ngaytruc>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ngay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Thu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tuan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lichtruc)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Ngay)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Thu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tuan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Lichtruc.GhiChu)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.NgaytrucID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.NgaytrucID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.NgaytrucID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
