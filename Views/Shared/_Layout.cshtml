<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trang Quản lý lịch trực</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyLichTruc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="container-fluid" style="background: #bcf4ff;">
            <div class="row">
                <div class="col-lg-3 d-flex mt-2 my-2">
                    <div><img src="~/images/Logo_AGU.png" width="55" /></div>
                    <div class="ms-2 mt-2"><h3 style="color: #196ac6; text-shadow: 2px 1px #fded89">THƯ VIỆN <br /> TRƯỜNG ĐẠI HỌC AN GIANG</h3></div>
                </div>
                <div class="col-lg-6 text-center">
                    <div class="mt-2 p-3 my-2" style="background: #0021ac; border-radius: 8px;"><h1 class="my-0">TRANG QUẢN LÝ PHẦN MỀM XẾP LỊCH TRỰC</h1></div>
                </div>
                <div class="col-lg-3">
                    <img src="~/images/Header_Visual.png" />
                </div>
            </div>
        </div>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3" style="background: #9ed0ff; color: #051c85;">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active text-dark" asp-controller="Home" asp-action="Index"><b>Trang chủ</b></a>
                    </li>
                    @if (ViewData["canbo"] != null && ViewBag.canbo.QuyenHan <= 1)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Lichtrucs" asp-action="Index">Quản lý lịch trực</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Canboes" asp-action="Index">Quản lý cán bộ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Lichbans" asp-action="Index">Quản lý lịch bận</a>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container-fluid fixed-bottom mb-0" style="background: #bcf4ff;">
            <div class="row text-center my-0">
                <div class="mb-0"><b>&copy; 2025. Thư viện Trường Đại học An Giang.</b> All Rights Reserved.</div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function hideForm() {
            var form = document.getElementById("formTaoLich");
            if (form.style.display == "none") {
                form.style.display = "block";
            } else {
                form.style.display = "none";
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
