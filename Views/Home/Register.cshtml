@{
    ViewData["Title"] = "Đăng ký người dùng";
}

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-lg-3"></div>
            <div class="col-lg-6">
                <div class="p-3" style="background-color: #dcfaff;"><h3 class="pt-1 my-0" align="center" style="color: #0b8aff;">Đăng ký tài khoản người dùng</h3></div>
                <div class="p-3 rounded-3 mt-3" style="background-color: #9ed0ff;">
                    <form asp-action="Register">
                        <div class="mb-3">
                            <label for="maso" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Mã số:</b></label>
                            <input type="text" class="form-control" id="maso" placeholder="Nhập vào mã số" name="MaSo" required/>
                        </div>
                        <div class="mb-3">
                            <label for="hoten" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Họ tên:</b></label>
                            <input type="text" class="form-control" id="hoten" placeholder="Nhập vào họ tên" name="HoTen" required/>
                        </div>
                        <div class="mb-3">
                            <label for="chucvu" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Chức vụ:</b></label>
                            <input type="text" class="form-control" id="chucvu" placeholder="Nhập vào chức vụ" name="ChucVu" required/>
                        </div>
                        <div class="mb-3">
                            <label for="sodienthoai" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Số điện thoại:</b></label>
                            <input type="text" class="form-control" id="sodienthoai" placeholder="Nhập số điện thoại" name="SoDienThoai" required/>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Email:</b></label>
                            <input type="email" class="form-control" id="email" placeholder="Nhập email" name="Email" required/>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Mật khẩu:</b></label>
                            <input type="password" class="form-control" id="password" placeholder="Nhập mật khẩu" name="MatKhau" required/>
                        </div>
                        <div class="mb-3">
                            <label for="password_confirmation" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Xác nhận mật khẩu vừa nhập:</b></label>
                            <input type="password" class="form-control" id="password_confirmation" placeholder="Vui lòng xác nhận mật khẩu" name="NhapLaiMatKhau" required/>
                        </div>
                        <div align="center">
                            <button type="submit" class="btn disabled" style="background-color: white; color: #0b8aff; border: #0561b7 solid 1px;">Gửi yêu cầu</button>
                        </div>
                    </form>
                </div>
                <div class="row mt-5 my-5"></div>
            </div>
            <div class="col-lg-3"></div>
        </div>
    </div>