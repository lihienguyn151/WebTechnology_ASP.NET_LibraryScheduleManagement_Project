                                                                                <select class="form-control mb-2" name="cahientai" id="CaHienTai" required>
                                                                                    @foreach (var catruc_canbo in (List<Catruc>) ViewData["dsct_cb"]) {
                                                                                        <option value="@catruc_canbo.CatrucID">
                                                                                            @{
                                                                                                string chuanhoa = "Ca " + catruc_canbo.SoThuTuCa + " - Ngày ";
                                                                                                if (catruc_canbo.Ngaytruc.Ngay < 10) {
                                                                                                    chuanhoa = chuanhoa + "0" + catruc_canbo.Ngaytruc.Ngay + "/";
                                                                                                }
                                                                                                else {
                                                                                                    chuanhoa = chuanhoa + catruc_canbo.Ngaytruc.Ngay + "/";
                                                                                                }
                                                                                                if (catruc_canbo.Ngaytruc.Lichtruc.Thang < 10) {
                                                                                                    chuanhoa = chuanhoa + "0" + catruc_canbo.Ngaytruc.Lichtruc.Thang + "/";
                                                                                                }
                                                                                                else {
                                                                                                    chuanhoa = chuanhoa + catruc_canbo.Ngaytruc.Lichtruc.Thang + "/";
                                                                                                }
                                                                                                chuanhoa = chuanhoa + catruc_canbo.Ngaytruc.Lichtruc.Nam;
                                                                                            }
                                                                                            @chuanhoa
                                                                                        </option>
                                                                                    }
                                                                                </select>
                                                                            </div>
                                                                            <div class="mb-3" align="left">
                                                                                <label for="lido" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Lí do:</b></label>
                                                                                <textarea class="form-control mb-3" rows="4" id="lido" name="LiDo" required></textarea>
                                                                            </div>
                                                                            <div align="center"><button type="submit" class="btn mb-2" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;">Gửi</button></div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            </div>
                                        }
                                        @{
                                            string kiemtra = "none";
                                            if (catruc != null && (catruc.CanboID != ViewBag.canbo.CanboID && catruc.TrangThai == 2)) {
                                                kiemtra = "";
                                            }
                                        }
                                        <div class="mt-3 mb-2" style="display: @(kiemtra);">
                                            <div align="center"><p class="p-2 rounded-2" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;">Chưa được xác nhận</p></div>
                                        </div>
                                    </td>
                                }
                            }
                            <td></td>
                        </tr>
                    </table>
                </div>
                <div class="row my-5"></div>
            </div>
        </div>
    </div>