@model QuanLyLichTruc.Models.Lichtruc

@{
    ViewData["Title"] = "Xem chi tiết lịch trực";
    int? thang = Model.Thang;
    var month = (thang < 10) ? "0" + thang : thang.ToString();
    var hienthi = new Ngaytruc();
}

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-lg-12">
                <div class="p-3" style="background-color: #dcfaff;"><h3 class="pt-1 my-0" align="center" style="color: #0b8aff;">Lịch phân công ca làm</h3></div>
                <div>
                    <table class="table table-bordered table-hover">
                        <tr align="center">
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 800;" width="80">Tuần 1</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Hai</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Ba</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Tư</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Năm</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Sáu</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Bảy</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Chủ Nhật</th>
                        </tr>
                        <tr align="center">
                            <td style="background-color: #dcfaff; color: #0b8aff; font-weight: 800;">Ngày</td>
                        @{
                            int dem = 1;
                        }
                        @for (var i = 1; i <= 7; i++)
                        {
                            int kt = 0;
                            foreach (var ngay in (List<Ngaytruc>)ViewData["dsnt_tuan1"])
                            {
                                if (ngay.Thu == i)
                                {
                                    kt = 1;
                                    hienthi = ngay;
                                    break;
                                }
                            }
                            if (kt == 0)
                            {
                                <td></td>
                            }
                            else
                            {
                                var day = (dem < 10) ? "0" + dem : dem.ToString();
                                var chuanhoa = day + "/" + month;
                                <td>@chuanhoa</td>
                                dem += 1;
                            }
                        }
                        </tr>
                        <tr>
                            <td align="center" style="vertical-align: middle"><b>Ca 1</b><br/><i>(Từ 07g00' - 15g00')</i></td>
                            @for (int i = 1; i <= 6; i++) {
                                    int kt = 0;
                                    var catruc = new Catruc();
                                    foreach (var ngay in (List<Ngaytruc>) ViewData["dsnt_tuan1"]) {
                                        if (ngay.Thu == i) {
                                            kt = 1;
                                            hienthi = ngay;
                                            foreach (var ct in (List<Catruc>)ViewData["dsct"])
                                            {
                                                if (ct.NgaytrucID == ngay.NgaytrucID && ct.SoThuTuCa == 1)
                                                {
                                                    catruc = ct;
                                                    break;
                                                }
                                            }
                                            break;
                                        }
                                    }
                                @if (kt == 0) {
                                    <td></td>
                                }
                                else {
                                    <td class="p-2" style="vertical-align: middle">
                                        @if (catruc != null && (ViewBag.canbo.CanboID == catruc.CanboID || (catruc.TrangThai != 2 && ViewBag.canbo.CanboID != catruc.CanboID))) {
                                            <div class="mt-2 container-fluid">
                                                <div class="row">
                                                    <div class="col-lg-10 p-0">
                                                        <div class="rounded-2 p-2" style="background-color: @(catruc.TrangThai==2?"red":"#0d00ff"); color: @(catruc.TrangThai==2?"white":"#faf9ff"); font-weight: bold;">@catruc.Canbo.MaSo - @catruc.Canbo.HoTen</div>
                                                    </div>
                                                    <div class="col-lg-2" style="align-content: center">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="diemdanh_check" name="diemdanh" disabled style="background-color: #0b8aff" @(catruc.DiemDanh==true?"checked":"")/>
                                                        </div>
                                                    </div>
                                                </div>
                                            @if (Model.TrangThai == true) {
                                                <hr/>
                                                <div class="my-3" align="center">
                                                    @if (catruc.CanboID == ViewBag.canbo.CanboID) {
                                                        @if (catruc.TrangThai == 1) {
                                                            <div class="mb-3"><a class="btn rounded-3 p-2 @(catruc.DiemDanh == true?"disabled":"")" asp-action="DiemDanh" asp-route-id="@catruc.CatrucID" style="background-color: #078500; color: #e4ffe3; font-size: 9pt; font-weight: bold; text-decoration: none;">&nbsp;&nbsp;Điểm danh&nbsp;&nbsp;</a></div>
                                                        }
                                                        else
                                                        {
                                                            <div class="mb-3"><a class="btn rounded-3 p-2" asp-action="XacNhanTruc" asp-route-id="@catruc.CatrucID" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;">&nbsp;&nbsp;Xác nhận&nbsp;&nbsp;</a></div>
                                                        }
                                                    }
                                                    else {
                                                        <div><a class="rounded-3 p-2" href="#" style="background-color: #ffc107; color: black; font-size: 9pt; font-weight: bold; text-decoration: none;" data-bs-toggle="modal" data-bs-target="#requestFormModal@(hienthi.NgaytrucID)_1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Yêu cầu đổi lịch&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</a></div>
                                                            <div class="modal fade" id="requestFormModal@(hienthi.NgaytrucID)_1" tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h3 class="modal-title pt-1 my-0" style="color: #0b8aff;">Yêu cầu đổi ca trực</h3>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                                    </div>
                                                                    <div class="modal-body p-3 mt-0">
                                                                        <form asp-action="YeuCauDoiCa">
                                                                            <input type="hidden" value="@ViewBag.canbo.CanboID" name="NguoiDoiID" />
                                                                            <input type="hidden" value="@catruc.CanboID" name="NguoiDuocYeuCauID" />
                                                                            <input type="hidden" value="@catruc.CatrucID" name="CamuondoiID"/>
                                                                            <div class="mb-3" align="left">
                                                                                <label for="cahientai" class="form-label"><b>Chọn ca trực muốn đổi:</b></label>
                                                                                <select class="form-control mb-2" name="cahientai" id="CaHienTai" required>
                                                                                    @foreach (var catruc_canbo in (List<Catruc>) ViewData["dsct_cb"]) {
                                                                                        <option value="@catruc_canbo.CatrucID">
                                                                                            @{
                                                                                                string chuanhoa = "Ca " + catruc_canbo.SoThuTuCa + " - Ngày ";
                                                                                                if (catruc_canbo.Ngaytruc.Ngay < 10) {
                                                                                                    chuanhoa = chuanhoa + "0" + catruc_canbo.Ngaytruc.Ngay + "/";
                                                                                                }
                                                                                                else {
                                                                                                    chuanhoa = chuanhoa + catruc_canbo.Ngaytruc.Ngay + "/";
                                                                                                }
                                                                                                if (catruc_canbo.Ngaytruc.Lichtruc.Thang < 10) {
                                                                                                    chuanhoa = chuanhoa + "0" + catruc_canbo.Ngaytruc.Lichtruc.Thang + "/";
                                                                                                }
                                                                                                else {
                                                                                                    chuanhoa = chuanhoa + catruc_canbo.Ngaytruc.Lichtruc.Thang + "/";
                                                                                                }
                                                                                                chuanhoa = chuanhoa + catruc_canbo.Ngaytruc.Lichtruc.Nam;
                                                                                            }
                                                                                            @chuanhoa
                                                                                        </option>
                                                                                    }
                                                                                </select>
                                                                            </div>
                                                                            <div class="mb-3" align="left">
                                                                                <label for="lido" class="form-label"><b style="font-family: Verdana; font-size: 11pt;">Lí do:</b></label>
                                                                                <textarea class="form-control mb-3" rows="4" id="lido" name="LiDo" required></textarea>
                                                                            </div>
                                                                            <div align="center"><button type="submit" class="btn mb-2" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;">Gửi</button></div>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            </div>
                                        }
                                        @{
                                            string kiemtra = "none";
                                            if (catruc != null && (catruc.CanboID != ViewBag.canbo.CanboID && catruc.TrangThai == 2)) {
                                                kiemtra = "";
                                            }
                                        }
                                        <div class="mt-3 mb-2" style="display: @(kiemtra);">
                                            <div align="center"><p class="p-2 rounded-2" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;">Chưa được xác nhận</p></div>
                                        </div>
                                    </td>
                                }
                            }
                            <td></td>
                        </tr>
