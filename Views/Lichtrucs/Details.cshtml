@model QuanLyLichTruc.Models.Lichtruc

@{
    ViewData["Title"] = "Xem lịch trực";
    int? thang = Model.Thang;
    var month = (thang < 10) ? "0" + thang : thang.ToString();
    var hienthi = new Ngaytruc();
}

<div class="mt-2 my-2 ms-3">
    <a class="text-decoration-none" style="font-size: 10pt; font-weight: 500" asp-action="Index"><i>Quản lý lịch trực</i></a>
    <a class="text-decoration-none" style="font-size: 10pt; font-weight: 500" href="#">&nbsp;&nbsp;&nbsp;>&nbsp;&nbsp;&nbsp;</a>
    <a class="text-decoration-none" style="font-size: 10pt; font-weight: 500" asp-action="Details" asp-route-id="@Model.LichtrucID"><i>Xem chi tiết lịch trực</i></a>
</div>

   <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2">
                <div class="p-3" style="background-color: #dcfaff;"><h3 class="pt-1 my-0" align="center" style="color: #0b8aff;">Tác vụ</h3></div>
                <div class="p-3" style="background-color: #dfefff" align="center">
                    <div><a class="btn mb-2 mt-1 @(Model.TrangThai==false?"disabled":"")" asp-action="SapXepLich" asp-route-id="@Model.LichtrucID" style="background-color: white; color: #0b8aff; border: #0561b7 solid 1px; width: 170px;" >Sắp xếp lịch</a></div>
                    <div><a class="btn mb-2 mt-1 @(Model.TrangThai == false ? "disabled" : "")" asp-action="LichSuDoi" asp-route-id="@Model.LichtrucID" style="background-color: white; color: #0b8aff; border: #0561b7 solid 1px; width: 170px;">Xem lịch sử đổi lịch</a></div>
                    <div><a class="btn mb-2 mt-1" asp-action="ExportExcel" asp-route-id="@Model.LichtrucID" style="background-color: white; color: #0b8aff; border: #0561b7 solid 1px; width: 170px;">Xuất excel</a></div>
                    <div><a class="btn mt-1 mb-1" href="#thongke" style="background-color: white; color: #0b8aff; border: #0561b7 solid 1px; width: 170px;">Xem bảng thống kê</a></div>
                </div>
            </div>
            <div class="col-lg-10">
                <div class="p-3" style="background-color: #dcfaff;"><h3 class="pt-1 my-0" align="center" style="color: #0b8aff;">Lịch phân công ca làm</h3></div>
                <div>
                    <table class="table table-bordered table-hover">
                        <tr align="center">
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 800;" width="80">Tuần 1</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Hai</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Ba</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Tư</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Năm</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Sáu</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Thứ Bảy</th>
                            <th style="background-color: #dfefff; color: #0021ac; font-weight: 500;" width="150">Chủ Nhật</th>
                        </tr>
                        <tr align="center">
                            <td style="background-color: #dcfaff; color: #0b8aff; font-weight: 800;">Ngày</td>
                        @{
                            int dem = 1;
                        }
                            @for (var i = 1; i <= 7; i++) {
                                int kt = 0;
                                foreach (var ngay in (List<Ngaytruc>) ViewData["dsnt_tuan1"]) {
                                        if (ngay.Thu == i) {
                                            kt = 1;
                                            hienthi = ngay;
                                            break;
                                        }
                                }
                                if (kt == 0) {
                                    <td></td>
                                }
                                else {
                                    var day = (dem < 10) ? "0"+ dem : dem.ToString();
                                    var chuanhoa = day + "/" + month;
                                    <td>@chuanhoa</td>
                                    dem += 1;
                                }
                            }
                        </tr>
                        <tr>
                            <td align="center" style="vertical-align: middle"><b>Ca 1</b><br/><i>(Từ 07g00' - 15g00')</i></td>
                            @for (int i = 1; i <= 6; i++) {
                                int kt = 0;
                                var catruc = new Catruc();
                                foreach (var ngay in (List<Ngaytruc>) ViewData["dsnt_tuan1"]) {
                                    if (ngay.Thu == i) {
                                        kt = 1;
                                        hienthi = ngay;
                                        foreach (var ct in (List<Catruc>) ViewData["dsct"]) {
                                            if (ct.NgaytrucID == ngay.NgaytrucID && ct.SoThuTuCa == 1) {
                                                catruc = ct;
                                                break;
                                            }
                                        }
                                        break;
                                    }
                                }
                                if (kt == 0) {
                                    <td></td>
                                }
                                else {
                                    <td class="p-2" style="vertical-align: middle">
                                        @if (catruc != null && catruc.Canbo != null) {
                                            <div class="mt-2 container-fluid">
                                                <div class="row">
                                                    <div class="col-lg-10 p-0">
                                                        <div class="rounded-2 p-2" style="background-color: #0d00ff; color: #faf9ff; font-weight: bold;">@catruc.Canbo.MaSo - @catruc.Canbo.HoTen</div>
                                                    </div>
                                                    <div class="col-lg-2" style="align-content: center">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" id="diemdanh_check" name="diemdanh" disabled style="background-color: #0b8aff" @(catruc.DiemDanh==true?"checked":"")/>
                                                        </div>
                                                    </div>
                                                </div>
                                            @if (Model.TrangThai == true) {
                                                <hr/>
                                                <div class="my-3" align="center">
                                                    <div class="mb-3"><a class="rounded-3 p-2" asp-action="RutLich" asp-route-id="@catruc.CatrucID" style="background-color: #ff154d; color: white; font-size: 9pt; font-weight: bold; text-decoration: none;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Rút lịch&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</a></div>
                                                    <div class="mb-3"><a class="rounded-3 p-2" asp-action="DiemDanh" asp-route-id="@catruc.CatrucID" style="background-color: #078500; color: #e4ffe3; font-size: 9pt; font-weight: bold; text-decoration: none;">&nbsp;&nbsp;Điểm danh&nbsp;&nbsp;</a></div>
                                                    <div><a class="rounded-3 p-2" asp-action="DoiLich" asp-route-id="@catruc.CatrucID" style="background-color: #ffc107; color: black; font-size: 9pt; font-weight: bold; text-decoration: none;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Đổi lịch&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</a></div>
                                                </div>
                                            }
                                            @foreach (var lsd in (List<Lichsudoi>) ViewData["dslsd"]) {
                                                if (catruc.CatrucID == lsd.CatrucID) {
                                                    <hr/>
                                                    <div class="rounded-2 p-2" style="background-color: #dcfaff; color: #0b8aff; font-weight: bold;"><span style="font-weight: 400; color: #0021ac;">Người đổi:</span>&nbsp;@lsd.NguoiDoi</div>
                                                    break;
                                                }
                                            }
                                            </div>
                                        }
                                        <div class="mb-2" style="display: @(catruc.Canbo != null?"none":"")">
                                            <div align="center"><button type="button" class="btn" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;" data-bs-toggle="modal" data-bs-target="#addFormModal@(hienthi.NgaytrucID)_1">Thêm cán bộ</button></div>
                                            <div class="modal fade" id="addFormModal@(hienthi.NgaytrucID)_1" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h3 class="modal-title pt-1 my-0" style="color: #0b8aff;">Thêm cán bộ trực</h3>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body p-3 mt-0">
                                                            <form asp-action="ThemCanBo">
                                                                <div class="mb-3">
                                                                    <input type="hidden" value="@Model.LichtrucID" name="id" />
                                                                    <input type="hidden" value="@hienthi.NgaytrucID" name="ngaytruc" />
                                                                    <input type="hidden" value="1" name="soca" />
                                                                    <label for="canbo" class="form-label" align="left">Chọn cán bộ thư viện</label>
                                                                    <select class="form-control mb-2" name="canbo" id="canbo" required>
                                                                        @foreach (var cb in (List<Canbo>) ViewData["dscb"]) {
                                                                            <option value="@cb.CanboID">@cb.HoTen</option>
                                                                            }
                                                                    </select>
                                                                </div>
                                                                <div align="center"><button type="submit" class="btn mb-2" style="background-color: #dcfaff; color: #0b8aff; border: #0561b7 solid 1px;">Lưu ca trực</button></div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                }
                            }
